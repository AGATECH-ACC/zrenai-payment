# Copy to .env and run scripts/setup_local.py to generate local application keys.
DJANGO_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://127.0.0.1:8000

# Curlec Dashboard → Test Mode → Account & Settings → API Keys
CURLEC_KEY_ID=
CURLEC_KEY_SECRET=
# Use this same independently generated secret in the Curlec webhook configuration.
CURLEC_WEBHOOK_SECRET=

# For HTTPS deployment: DEBUG=false, APP_BASE_URL=https://your-domain,
# ALLOWED_HOSTS=your-domain, and persistent storage for SQLITE_PATH.
# SQLITE_PATH=data/gateway.sqlite3
